NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safe_solutions_ops
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

# JWT — change both secrets before deploying to production
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Default password assigned to every seeded / newly created account
DEFAULT_PASSWORD=Safe@123

# Office GPS geofence
OFFICE_LAT=31.5497
OFFICE_LNG=74.3436
OFFICE_RADIUS_METERS=500

# CORS — set to your frontend origin
CLIENT_ORIGIN=http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5